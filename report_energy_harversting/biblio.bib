@article{FERNANDEZESCUDERO2019102744,
title = {Comparison of low, medium and high fidelity numerical methods for unsteady aerodynamics and nonlinear aeroelasticity},
journal = {Journal of Fluids and Structures},
volume = {91},
pages = {102744},
year = {2019},
issn = {0889-9746},
doi = {https://doi.org/10.1016/j.jfluidstructs.2019.102744},
url = {https://www.sciencedirect.com/science/article/pii/S0889974618307096},
author = {Claudia Fernandez-Escudero and Miguel Gagnon and Eric Laurendeau and Sebastien Prothin and Guilhem Michon and Annie Ross},
keywords = {Aeroelasticity, Unsteady aerodynamics, Flutter, LCO, Non-linear dynamics, Theodorsen, Vortex Lattice Method, Reynolds Averaged Navier Stokes, Euler, Control surface, Freeplay, Cubic stiffness},
abstract = {The unsteady aerodynamic and aeroelastic behavior of a 2D wing section with and without flap is analyzed with Theodorsen theory and Unsteady Vortex Lattice Method (low fidelity), Euler (medium fidelity) and Reynolds-Averaged Navier Stokes (high fidelity) methods. The aeroelastic studies are carried out for linear cases and non-linear structural configurations presenting cubic stiffness and freeplay. The critical flutter speeds as well as the limit cycle oscillations present in the non-linear cases are compared. The methods show good agreement for the cases studied.}
}
